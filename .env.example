# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Supabase — waitlist storage
# ---------------------------------------------------------------------------
# Deliberately NOT prefixed with NEXT_PUBLIC_: the waitlist insert runs in a
# Server Action, so these values must never reach the browser bundle.
#
# Use the *anon* (publishable) key, not the service-role key. From migration
# 0003 onward the app can call only narrow RPC functions and has no direct
# table access — see supabase/migrations/0003_waitlist_double_opt_in.sql.
#
# Without these two values the form refuses the submission and shows an error.
# It never pretends a signup succeeded.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Resend — double opt-in mail
# ---------------------------------------------------------------------------
# Required. A signup that cannot be confirmed is not a signup, so a missing key
# here rejects the submission with a real error rather than storing a row
# nobody can confirm.
#
# Resend is a US provider: the privacy policy carries a third-country transfer
# entry, and a data processing agreement has to be in place. The send path is
# one file (src/lib/mail/send.server.ts) so an EU provider can replace it.
RESEND_API_KEY=
# Sender, as "Name <address>". Use a subdomain dedicated to mail so the sending
# reputation stays separate from the rest of the domain, e.g.
# Evi <hallo@mail.example.de>. The domain must be verified in Resend with SPF,
# DKIM and DMARC — Gmail and Yahoo reject bulk senders without them.
WAITLIST_MAIL_FROM=

# Secret for deriving unsubscribe tokens. Generate once with:
#
#   openssl rand -base64 32
#
# Unsubscribe links are derived from this secret plus the address rather than
# being random, so a link printed in a mail sent weeks ago keeps working.
# Changing this value invalidates every unsubscribe link ever sent, so it is
# not rotated casually.
WAITLIST_TOKEN_SECRET=

# Protects the daily Vercel keep-alive route. Generate once, for example with
# `openssl rand -base64 32`, and set the same value in Vercel Production.
CRON_SECRET=

# ---------------------------------------------------------------------------
# PostHog — product analytics
# ---------------------------------------------------------------------------
# Optional. If unset, no analytics is loaded and the page works normally.
# Analytics only starts after the visitor accepts in the consent banner.
NEXT_PUBLIC_POSTHOG_KEY=
# EU cloud by default. Use https://us.i.posthog.com for a US project.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---------------------------------------------------------------------------
# Anthropic — "Frag Evi selbst" landing-page chat
# ---------------------------------------------------------------------------
# Powers /api/evi-chat, called from src/components/sections/ask-evi.tsx.
# Without a key the widget still works but only ever shows its honest
# fallback ("schreib uns auf Instagram/E-Mail") — it never fakes a reply.
#
# Create a key at https://console.anthropic.com. The route calls the Messages
# API directly over fetch() (see src/lib/evi-chat/anthropic-client.server.ts)
# rather than adding the SDK, same reasoning as the Resend integration below.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5 in code if unset.
ANTHROPIC_MODEL=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute base URL for canonical links, Open Graph and the sitemap, without a
# trailing slash.
#
# The target address is https://evi-de.vercel.app — reached by naming the
# Vercel project "evi-de". Once the project exists, Vercel sets
# VERCEL_PROJECT_PRODUCTION_URL itself and this variable can stay empty.
#
# Set it explicitly for anonymous deployments (which get no project domain) and
# as soon as a custom domain is connected — otherwise link previews keep
# pointing at the *.vercel.app address.
NEXT_PUBLIC_SITE_URL=https://evi-de.vercel.app
